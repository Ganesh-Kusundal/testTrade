# Dhan Broker API Configuration
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to version control

DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here
DHAN_AUTH_MODE=STATIC
DHAN_PIN=your_pin_here
DHAN_TOTP_SECRET=your_totp_secret_here
DHAN_ENVIRONMENT=LIVE
DHAN_REFRESH_BUFFER_MINUTES=10
# SCALPR Environment Configuration
# Copy this file to .env and update with your credentials

# Environment Mode: "development" or "production"
# CRITICAL: Set to "production" to disable synthetic tick simulation
SCALPR_ENV=development

# Dhan Broker Configuration
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here

# Optional: Dhan Sandbox Mode (for testing)
# DHAN_ENVIRONMENT=sandbox

# Optional: Database Path (SQLite for OMS persistence)
# OMS_DB_PATH=./data/oms.db

# Optional: WebSocket Configuration
# WS_HEARTBEAT_INTERVAL=30
# WS_RECONNECT_MAX_RETRIES=5
